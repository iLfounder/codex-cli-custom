{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "AccountSlotAction": {
      "enum": [
        "login",
        "retryLogin",
        "switchTo",
        "logout"
      ],
      "type": "string"
    },
    "AccountSlotActionAvailability": {
      "properties": {
        "action": {
          "$ref": "#/definitions/AccountSlotAction"
        },
        "allowed": {
          "type": "boolean"
        },
        "denyReason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "action",
        "allowed"
      ],
      "type": "object"
    },
    "AccountSlotLoginChallenge": {
      "oneOf": [
        {
          "properties": {
            "authUrl": {
              "type": "string"
            },
            "loginId": {
              "type": "string"
            },
            "type": {
              "enum": [
                "browser"
              ],
              "title": "BrowserAccountSlotLoginChallengeType",
              "type": "string"
            }
          },
          "required": [
            "authUrl",
            "loginId",
            "type"
          ],
          "title": "BrowserAccountSlotLoginChallenge",
          "type": "object"
        },
        {
          "properties": {
            "loginId": {
              "type": "string"
            },
            "type": {
              "enum": [
                "deviceCode"
              ],
              "title": "DeviceCodeAccountSlotLoginChallengeType",
              "type": "string"
            },
            "userCode": {
              "type": "string"
            },
            "verificationUrl": {
              "type": "string"
            }
          },
          "required": [
            "loginId",
            "type",
            "userCode",
            "verificationUrl"
          ],
          "title": "DeviceCodeAccountSlotLoginChallenge",
          "type": "object"
        }
      ]
    },
    "AccountSlotSnapshot": {
      "description": "A host-managed account slot without credential paths, email addresses, or tokens.",
      "properties": {
        "accountNumber": {
          "description": "Stable display order within this app-server's account registry.",
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "accountSlotId": {
          "type": "string"
        },
        "actions": {
          "items": {
            "$ref": "#/definitions/AccountSlotActionAvailability"
          },
          "type": "array"
        },
        "activeLoginOperationId": {
          "type": [
            "string",
            "null"
          ]
        },
        "attemptGeneration": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "authMode": {
          "anyOf": [
            {
              "$ref": "#/definitions/AuthMode"
            },
            {
              "type": "null"
            }
          ]
        },
        "errorCode": {
          "type": [
            "string",
            "null"
          ]
        },
        "isDefault": {
          "type": "boolean"
        },
        "label": {
          "type": "string"
        },
        "registryRevision": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "status": {
          "$ref": "#/definitions/AccountSlotStatus"
        },
        "updatedAt": {
          "description": "Unix timestamp in seconds when the slot last changed.",
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "accountNumber",
        "accountSlotId",
        "actions",
        "attemptGeneration",
        "isDefault",
        "label",
        "registryRevision",
        "status",
        "updatedAt"
      ],
      "type": "object"
    },
    "AccountSlotStatus": {
      "enum": [
        "loginRequired",
        "ready",
        "failed"
      ],
      "type": "string"
    },
    "AuthMode": {
      "description": "Authentication mode for OpenAI-backed providers.",
      "oneOf": [
        {
          "description": "OpenAI API key provided by the caller and stored by Codex.",
          "enum": [
            "apikey"
          ],
          "type": "string"
        },
        {
          "description": "ChatGPT OAuth managed by Codex (tokens persisted and refreshed by Codex).",
          "enum": [
            "chatgpt"
          ],
          "type": "string"
        },
        {
          "description": "[UNSTABLE] FOR OPENAI INTERNAL USE ONLY - DO NOT USE.\n\nChatGPT auth tokens are supplied by an external host app and are only stored in memory. Token refresh must be handled by the external host app.",
          "enum": [
            "chatgptAuthTokens"
          ],
          "type": "string"
        },
        {
          "description": "Backend auth supplied as request headers.",
          "enum": [
            "headers"
          ],
          "type": "string"
        },
        {
          "description": "Programmatic Codex auth backed by a registered Agent Identity.",
          "enum": [
            "agentIdentity"
          ],
          "type": "string"
        },
        {
          "description": "Programmatic Codex auth backed by a personal access token.",
          "enum": [
            "personalAccessToken"
          ],
          "type": "string"
        },
        {
          "description": "Amazon Bedrock bearer token managed by Codex.",
          "enum": [
            "bedrockApiKey"
          ],
          "type": "string"
        }
      ]
    },
    "SessionRuntimeOperation": {
      "description": "Common operation state returned by controls and published as progress changes.",
      "properties": {
        "accountSlotId": {
          "type": [
            "string",
            "null"
          ]
        },
        "action": {
          "$ref": "#/definitions/SessionRuntimeOperationAction"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/definitions/SessionRuntimeOperationError"
            },
            {
              "type": "null"
            }
          ]
        },
        "executionGeneration": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "operationId": {
          "type": "string"
        },
        "requestFingerprint": {
          "description": "Opaque digest of the normalized action and arguments. Reusing an operation id with a different fingerprint is an invalid request rather than an idempotent retry.",
          "type": "string"
        },
        "stateRevision": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "status": {
          "$ref": "#/definitions/SessionRuntimeOperationStatus"
        },
        "threadId": {
          "type": [
            "string",
            "null"
          ]
        },
        "updatedAt": {
          "description": "Unix timestamp in seconds when this operation state was produced.",
          "format": "int64",
          "type": "integer"
        },
        "writerGeneration": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "action",
        "operationId",
        "requestFingerprint",
        "status",
        "updatedAt"
      ],
      "type": "object"
    },
    "SessionRuntimeOperationAction": {
      "enum": [
        "accountSlotLogin",
        "threadAccountSwitch",
        "threadRelinquish"
      ],
      "type": "string"
    },
    "SessionRuntimeOperationError": {
      "description": "Sanitized operation failure; it never contains tokens, paths, sockets, or raw PIDs.",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "SessionRuntimeOperationStatus": {
      "enum": [
        "accepted",
        "running",
        "released",
        "ready",
        "failed"
      ],
      "type": "string"
    }
  },
  "properties": {
    "challenge": {
      "anyOf": [
        {
          "$ref": "#/definitions/AccountSlotLoginChallenge"
        },
        {
          "type": "null"
        }
      ]
    },
    "operation": {
      "$ref": "#/definitions/SessionRuntimeOperation"
    },
    "slot": {
      "$ref": "#/definitions/AccountSlotSnapshot"
    }
  },
  "required": [
    "operation",
    "slot"
  ],
  "title": "AccountSlotLoginStartResponse",
  "type": "object"
}