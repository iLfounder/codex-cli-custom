{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ThreadAccountRotationMode": {
      "enum": [
        "fixed",
        "quotaAware",
        "roundRobin",
        "exhaustThenNext"
      ],
      "type": "string"
    },
    "ThreadAccountRotationSnapshot": {
      "properties": {
        "automaticAccountSlotIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "fixedAccountSlotId": {
          "type": [
            "string",
            "null"
          ]
        },
        "lastCommittedAccountSlotId": {
          "type": [
            "string",
            "null"
          ]
        },
        "mode": {
          "$ref": "#/definitions/ThreadAccountRotationMode"
        },
        "revision": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "automaticAccountSlotIds",
        "mode",
        "revision"
      ],
      "type": "object"
    }
  },
  "properties": {
    "rotation": {
      "$ref": "#/definitions/ThreadAccountRotationSnapshot"
    }
  },
  "required": [
    "rotation"
  ],
  "title": "ThreadAccountRotationReadResponse",
  "type": "object"
}