{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "AccountSlotAction": {
      "enum": [
        "login",
        "retryLogin",
        "switchTo",
        "logout"
      ],
      "type": "string"
    },
    "AccountSlotActionAvailability": {
      "properties": {
        "action": {
          "$ref": "#/definitions/AccountSlotAction"
        },
        "allowed": {
          "type": "boolean"
        },
        "denyReason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "action",
        "allowed"
      ],
      "type": "object"
    },
    "AccountSlotCapability": {
      "description": "Sanitized capability state for account-slot operations.",
      "properties": {
        "available": {
          "type": "boolean"
        },
        "denyReason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "available"
      ],
      "type": "object"
    },
    "AccountSlotCatalogKind": {
      "enum": [
        "legacy",
        "global"
      ],
      "type": "string"
    },
    "AccountSlotHealth": {
      "enum": [
        "healthy",
        "degraded",
        "unavailable"
      ],
      "type": "string"
    },
    "AccountSlotQuotaMeter": {
      "description": "One sanitized quota meter. It contains no provider or credential identity.",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "remainingPercent": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "resetsAt": {
          "description": "Unix timestamp in seconds when this meter resets, or `null` when unknown.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "remainingPercent"
      ],
      "type": "object"
    },
    "AccountSlotQuotaSnapshot": {
      "description": "Sanitized quota projection used for display and account selection.",
      "properties": {
        "meters": {
          "items": {
            "$ref": "#/definitions/AccountSlotQuotaMeter"
          },
          "type": "array"
        },
        "observedAt": {
          "description": "Unix timestamp in seconds represented by this quota projection.",
          "format": "int64",
          "type": "integer"
        },
        "staleAt": {
          "description": "Unix timestamp in seconds after which the projection is stale.",
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "meters",
        "observedAt",
        "staleAt"
      ],
      "type": "object"
    },
    "AccountSlotSnapshot": {
      "description": "A global account projection without credential paths, email addresses, or tokens.",
      "properties": {
        "accountNumber": {
          "description": "Stable global display and tie-break order.",
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "accountSlotId": {
          "description": "Stable logical account identity. Canonical global values are `C<N>`; legacy local slot identifiers remain accepted for compatibility.",
          "type": "string"
        },
        "actions": {
          "items": {
            "$ref": "#/definitions/AccountSlotActionAvailability"
          },
          "type": "array"
        },
        "activeLoginOperationId": {
          "type": [
            "string",
            "null"
          ]
        },
        "attemptGeneration": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "authMode": {
          "anyOf": [
            {
              "$ref": "#/definitions/AuthMode"
            },
            {
              "type": "null"
            }
          ]
        },
        "errorCode": {
          "type": [
            "string",
            "null"
          ]
        },
        "health": {
          "allOf": [
            {
              "$ref": "#/definitions/AccountSlotHealth"
            }
          ],
          "default": "unavailable",
          "description": "Freshness and availability of the sanitized global projection."
        },
        "isDefault": {
          "type": "boolean"
        },
        "label": {
          "type": "string"
        },
        "quota": {
          "anyOf": [
            {
              "$ref": "#/definitions/AccountSlotQuotaSnapshot"
            },
            {
              "type": "null"
            }
          ],
          "description": "Sanitized quota meters supplied by the global account projection."
        },
        "registryRevision": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "status": {
          "$ref": "#/definitions/AccountSlotStatus"
        },
        "updatedAt": {
          "description": "Unix timestamp in seconds when the slot last changed.",
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "accountNumber",
        "accountSlotId",
        "actions",
        "attemptGeneration",
        "isDefault",
        "label",
        "registryRevision",
        "status",
        "updatedAt"
      ],
      "type": "object"
    },
    "AccountSlotStatus": {
      "enum": [
        "loginRequired",
        "ready",
        "failed"
      ],
      "type": "string"
    },
    "AuthMode": {
      "description": "Authentication mode for OpenAI-backed providers.",
      "oneOf": [
        {
          "description": "OpenAI API key provided by the caller and stored by Codex.",
          "enum": [
            "apikey"
          ],
          "type": "string"
        },
        {
          "description": "ChatGPT OAuth managed by Codex (tokens persisted and refreshed by Codex).",
          "enum": [
            "chatgpt"
          ],
          "type": "string"
        },
        {
          "description": "[UNSTABLE] FOR OPENAI INTERNAL USE ONLY - DO NOT USE.\n\nChatGPT auth tokens are supplied by an external host app and are only stored in memory. Token refresh must be handled by the external host app.",
          "enum": [
            "chatgptAuthTokens"
          ],
          "type": "string"
        },
        {
          "description": "Backend auth supplied as request headers.",
          "enum": [
            "headers"
          ],
          "type": "string"
        },
        {
          "description": "Programmatic Codex auth backed by a registered Agent Identity.",
          "enum": [
            "agentIdentity"
          ],
          "type": "string"
        },
        {
          "description": "Programmatic Codex auth backed by a personal access token.",
          "enum": [
            "personalAccessToken"
          ],
          "type": "string"
        },
        {
          "description": "Amazon Bedrock bearer token managed by Codex.",
          "enum": [
            "bedrockApiKey"
          ],
          "type": "string"
        }
      ]
    }
  },
  "description": "A revision-consistent page of sanitized global accounts.",
  "properties": {
    "catalogKind": {
      "allOf": [
        {
          "$ref": "#/definitions/AccountSlotCatalogKind"
        }
      ],
      "default": "legacy",
      "description": "Revision domain used by this complete list. Older servers omit this field and are treated as legacy catalogs by compatible clients."
    },
    "data": {
      "items": {
        "$ref": "#/definitions/AccountSlotSnapshot"
      },
      "type": "array"
    },
    "multiAccount": {
      "$ref": "#/definitions/AccountSlotCapability"
    },
    "nextCursor": {
      "description": "Opaque cursor bound to `registryRevision` and a stable sort anchor. A stale-cursor error requires restarting from the first page.",
      "type": [
        "string",
        "null"
      ]
    },
    "registryRevision": {
      "description": "Normalized semantic generation of the global account catalog.",
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    }
  },
  "required": [
    "data",
    "multiAccount",
    "registryRevision"
  ],
  "title": "AccountSlotListResponse",
  "type": "object"
}