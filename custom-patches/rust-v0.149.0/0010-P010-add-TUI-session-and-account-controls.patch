+    let params = serde_json::from_value::<ThreadResumeParams>(json!({
+        "threadId": "thr_123",
+        "dynamicTools": [{
+            "type": "function",
+            "name": "threadClear",
+            "description": "Clear the current thread",
+            "inputSchema": {
+                "type": "object",
+                "properties": {},
