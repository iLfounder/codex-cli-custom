+            .bind(i64::try_from(next_generation)?)
+            .bind(thread_id.to_string())
+            .bind(&expected_binding.slot_id)
+            .bind(i64::try_from(expected_binding.generation)?)
+            .execute(&mut *transaction)
+            .await?;
