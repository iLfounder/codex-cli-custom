+            let (auth_manager, models_manager) = account.ok_or_else(|| {
+                codex_protocol::error::CodexErr::InvalidRequest(
+                    "test account is unavailable".to_string(),
+                )
+            })?;
+            Ok(Arc::new(ExecutionAccountContext {
+                binding,
+                auth_manager,
+                models_manager,
