+#[derive(Default)]
+struct EngineState {
+    sequence: u64,
+    threads: HashMap<ThreadId, RuntimeThreadState>,
+    listed_threads: HashSet<ThreadId>,
+    pages: pagination::SnapshotCache,
+    #[allow(dead_code)]
+    operations: OperationCache,
+}
+
+#[derive(Default)]
+struct RuntimeThreadState {
