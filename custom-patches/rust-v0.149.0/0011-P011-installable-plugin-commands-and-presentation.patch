 }
 
+fn runtime_proves_thread_transition_committed(
+    runtime: &crate::app_server_session::ThreadRuntimeSnapshot,
+    preparation: &codex_app_server_protocol::ThreadTransitionPreparation,
+) -> bool {
+    runtime
+        .snapshot
+        .continuity
+        .last_incoming
+        .iter()
