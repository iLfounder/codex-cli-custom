+            request_id: RequestId::String(format!("tui-plugin-command-invoke-{}", Uuid::new_v4())),
+            params: PluginCommandInvokeParams {
+                thread_id: thread_id.to_string(),
+                command_id,
+            },
+        })
+        .await
+        .map_err(Into::into)
+}
