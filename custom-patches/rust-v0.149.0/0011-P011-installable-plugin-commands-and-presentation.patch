+{ "method": "thread/presentation/append", "id": 33, "params": {
+    "threadId": "thr_123",
+    "item": {
+        "type": "progress",
+        "id": "relay-sync",
+        "label": "Relay sync",
+        "current": 3,
+        "total": 10
+    }
+} }
+{ "id": 33, "result": { "deliveredTo": 1 } }
+{ "method": "thread/presentation/appended", "params": {
+    "threadId": "thr_123",
+    "item": {
+        "type": "progress",
+        "id": "relay-sync",
+        "label": "Relay sync",
+        "current": 3,
+        "total": 10
+    }
+} }
