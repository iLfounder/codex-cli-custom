+        let (result_tx, result_rx) = tokio::sync::oneshot::channel();
+        self.session
+            .spawn_task(
+                turn_context,
+                Vec::new(),
+                crate::tasks::PluginExecutableTask::new(package_root, executable, argv, result_tx),
+            )
+            .await;
+        drop(transition);
+        result_rx
+            .await
+            .map_err(|_| "plugin executable task ended without a result".to_string())?
+    }
