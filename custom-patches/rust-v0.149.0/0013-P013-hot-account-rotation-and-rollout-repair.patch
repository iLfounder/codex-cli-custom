+            "Affected suffix records: {}",
+            outcome.affected_suffix_records.unwrap_or(0)
+        );
+        println!("Mutations: {}", outcome.mutation_count.unwrap_or(0));
+        if let Some(path) = outcome.backup_path.as_ref() {
