+fn decode_checksum(checksum: &str) -> Vec<u8> {
+    (0..checksum.len())
+        .step_by(2)
+        .map(|offset| {
+            u8::from_str_radix(&checksum[offset..offset + 2], 16)
+                .expect("checksum should be hexadecimal")
+        })
+        .collect()
+}
