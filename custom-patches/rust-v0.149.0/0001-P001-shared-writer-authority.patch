+"#,
+    legacy_upstream_version: 50,
+    legacy_description: "thread execution account bindings",
+    legacy_checksum: "35b8f0203829d22c122233012fa066fe6be269395e9e0f7a16848722f8ecd34124097826db94bef9925f88b381c2223b",
+    required_tables: &[
