+    let action = lifecycle_action(&cli.subcommand).expect("lifecycle action");
+    validate_invocation(
+        &cli.config_overrides,
+        &cli.feature_toggles,
+        &cli.remote,
+        &cli.interactive,
+        action,
+    )
+}
