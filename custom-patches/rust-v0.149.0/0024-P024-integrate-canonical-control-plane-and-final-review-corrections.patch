+            fs::set_permissions(
+                owner_home.path().join(".config/codex-accounts.tsv"),
+                fs::Permissions::from_mode(0o600),
+            )
+            .expect("catalog permissions");
+        }
+        Self {
+            _owner_home: owner_home,
+            codex_home,
+        }
+    }
