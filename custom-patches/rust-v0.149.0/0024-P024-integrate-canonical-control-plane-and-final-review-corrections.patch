+#[test]
+fn global_commit_claim_is_irreversible_for_late_cancel() {
+    let terminal = GlobalLoginTerminal::default();
+
+    assert!(terminal.try_begin_commit());
+    assert!(!terminal.request_cancel());
+    assert!(!terminal.try_begin_commit());
+}
