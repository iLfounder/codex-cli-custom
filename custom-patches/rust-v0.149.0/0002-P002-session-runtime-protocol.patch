+        "released",
+        "ready",
+        "failed"
+      ],
+      "type": "string"
+    }
+  },
+  "description": "Progress or terminal state for a bounded process-local operation.",
+  "properties": {
+    "instanceEpoch": {
+      "type": "string"
+    },
+    "operation": {
+      "$ref": "#/definitions/SessionRuntimeOperation"
