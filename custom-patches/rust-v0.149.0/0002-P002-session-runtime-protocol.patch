+        "operationId",
+        "requestFingerprint",
+        "status",
+        "updatedAt"
+      ],
+      "type": "object"
+    },
+    "SessionRuntimeOperationAction": {
+      "enum": [
+        "accountSlotLogin",
+        "threadAccountSwitch",
+        "threadRelinquish"
+      ],
+      "type": "string"
+    },
+    "SessionRuntimeOperationError": {
+      "description": "Sanitized operation failure; it never contains tokens, paths, sockets, or raw PIDs.",
+      "properties": {
+        "code": {
+          "type": "string"
