+    #[test]
+    fn qualified_skill_slash_uses_trimmed_default_prompt() {
+        let (mut composer, _rx) = new_test_composer();
+        let mut skill = test_skill_metadata("calendar:meeting-prep");
+        skill.interface = Some(SkillInterface {
+            display_name: None,
+            short_description: None,
+            icon_small: None,
+            icon_large: None,
+            icon_small_url: None,
+            icon_large_url: None,
+            brand_color: None,
+            default_prompt: Some("  prepare the meeting  ".to_string()),
+        });
+        let expected_path = skill.path.clone();
+        composer.set_skill_mentions(Some(vec![skill]));
+        composer.set_text_content("/calendar:meeting-prep".to_string(), Vec::new(), Vec::new());
+
+        let (result, _) =
+            composer.handle_key_event(KeyEvent::new(KeyCode::Enter, KeyModifiers::NONE));
+
+        assert_eq!(
+            result,
+            InputResult::SkillCommand {
+                text: "prepare the meeting".to_string(),
+                text_elements: Vec::new(),
+                skill: SkillSlashCommand {
+                    name: "calendar:meeting-prep".to_string(),
+                    description: "Example skill used in tests.".to_string(),
+                    default_prompt: Some("  prepare the meeting  ".to_string()),
+                    path: expected_path,
+                },
+            }
+        );
+    }
+
+    #[test]
+    fn inline_skill_slash_trims_args_and_rebases_text_elements() {
+        let (mut composer, _rx) = new_test_composer();
+        let skill = test_skill_metadata("reviewer");
+        let expected_path = skill.path.clone();
+        composer.set_skill_mentions(Some(vec![skill]));
+        let text = "/reviewer   [Pasted Content]  ";
+        let element_start = text.find("[Pasted Content]").expect("placeholder");
+        let element_end = element_start + "[Pasted Content]".len();
+        composer.set_text_content(
+            text.to_string(),
+            vec![TextElement::new(
+                (element_start..element_end).into(),
+                Some("[Pasted Content]".to_string()),
+            )],
+            Vec::new(),
+        );
+
+        let (result, _) =
+            composer.handle_key_event(KeyEvent::new(KeyCode::Enter, KeyModifiers::NONE));
+
+        assert_eq!(
+            result,
+            InputResult::SkillCommand {
+                text: "[Pasted Content]".to_string(),
+                text_elements: vec![TextElement::new(
+                    (0.."[Pasted Content]".len()).into(),
+                    Some("[Pasted Content]".to_string()),
+                )],
+                skill: SkillSlashCommand {
+                    name: "reviewer".to_string(),
+                    description: "Example skill used in tests.".to_string(),
+                    default_prompt: None,
+                    path: expected_path,
+                },
+            }
+        );
+    }
+
