diff --git a/codex-rs/tui/src/app/runtime_controls.rs b/codex-rs/tui/src/app/runtime_controls.rs
new file mode 100644
index 0000000..0652b34
--- /dev/null
+++ b/codex-rs/tui/src/app/runtime_controls.rs
@@ -0,0 +1,395 @@
+//! Release-aware app-server controls used by explicit TUI exit and logout actions.
+
+use super::*;
+use crate::app_server_session::AccountSlotsSnapshot;
+use crate::app_server_session::SessionRuntimeLookup;
+use crate::app_server_session::list_account_slots;
+use crate::app_server_session::logout_account_with_request_handle;
+use crate::app_server_session::relinquish_thread;
+use crate::app_server_session::session_runtime_for_thread;
+use codex_app_server_protocol::SessionRuntimeOperation;
+use codex_app_server_protocol::SessionRuntimeOperationAction;
+use codex_app_server_protocol::SessionRuntimeOperationStatus;
+use codex_app_server_protocol::ThreadRelinquishParams;
+
+pub(super) const SHUTDOWN_RELEASE_TIMEOUT: Duration = Duration::from_secs(/*secs*/ 2);
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum ShutdownIntent {
+    Exit,
+    LogoutDefault,
+}
+
+#[derive(Debug)]
+pub(super) struct PendingShutdownExit {
+    pub(super) intent: ShutdownIntent,
+    pub(super) thread_id: ThreadId,
+    pub(super) operation_id: String,
+    pub(super) instance_epoch: String,
+    pub(super) state_revision: u64,
+    pub(super) writer_generation: u64,
+    pub(super) released: bool,
+    pub(super) thread_closed: bool,
+}
+
+impl PendingShutdownExit {
+    fn matches_operation(&self, operation: &SessionRuntimeOperation) -> bool {
+        operation.operation_id == self.operation_id
+            && operation.thread_id.as_deref() == Some(self.thread_id.to_string().as_str())
+            && operation.action == SessionRuntimeOperationAction::ThreadRelinquish
+    }
+}
+
+impl App {
+    pub(super) fn begin_shutdown_runtime_lookup(
+        &mut self,
+        app_server: &AppServerSession,
+        intent: ShutdownIntent,
+    ) {
+        if self.pending_shutdown_exit.is_some() {
+            self.show_shutdown_waiting_picker();
+            return;
+        }
+        if self.shutdown_lookup_in_flight {
+            return;
+        }
+        let Some(thread_id) = self.current_displayed_thread_id() else {
+            self.finish_shutdown_without_thread(app_server, intent);
+            return;
+        };
+        self.shutdown_lookup_in_flight = true;
+        let request_handle = app_server.request_handle();
+        let slot_request_handle = request_handle.clone();
+        let app_event_tx = self.app_event_tx.clone();
+        tokio::spawn(async move {
+            let (result, slots) = match intent {
+                ShutdownIntent::Exit => (
+                    session_runtime_for_thread(request_handle, thread_id)
+                        .await
+                        .map_err(|error| error.to_string()),
+                    None,
+                ),
+                ShutdownIntent::LogoutDefault => {
+                    let (runtime, slots) = tokio::join!(
+                        session_runtime_for_thread(request_handle, thread_id),
+                        list_account_slots(slot_request_handle)
+                    );
+                    (
+                        runtime.map_err(|error| error.to_string()),
+                        Some(slots.map_err(|error| error.to_string())),
+                    )
+                }
+            };
+            app_event_tx.send(AppEvent::ShutdownRuntimeLoaded {
+                thread_id,
+                intent,
+                result,
+                slots,
+            });
+        });
+    }
+
+    fn finish_shutdown_without_thread(
+        &self,
+        app_server: &AppServerSession,
+        intent: ShutdownIntent,
+    ) {
+        match intent {
+            ShutdownIntent::Exit => self.app_event_tx.send(AppEvent::Exit(ExitMode::Immediate)),
+            ShutdownIntent::LogoutDefault => {
+                self.begin_stock_logout(app_server);
+            }
+        }
+    }
+
+    pub(super) async fn handle_shutdown_runtime_loaded(
+        &mut self,
+        app_server: &mut AppServerSession,
+        thread_id: ThreadId,
+        intent: ShutdownIntent,
+        result: Result<SessionRuntimeLookup, String>,
+        slots: Option<Result<AccountSlotsSnapshot, String>>,
+    ) -> AppRunControl {
+        self.shutdown_lookup_in_flight = false;
+        let response = match result {
+            Ok(SessionRuntimeLookup::Supported(response)) => response,
+            Ok(SessionRuntimeLookup::Unsupported) => {
+                return self.handle_stock_shutdown(app_server, intent).await;
+            }
+            Err(error) => {
+                self.shutdown_control_failed(format!("Could not verify session release: {error}"));
+                return AppRunControl::Continue;
+            }
+        };
+        let Some(snapshot) = response
+            .data
+            .into_iter()
+            .find(|snapshot| snapshot.thread_id == thread_id.to_string())
+        else {
+            self.shutdown_control_failed("The active session runtime is unavailable.".to_string());
+            return AppRunControl::Continue;
+        };
+        if intent == ShutdownIntent::LogoutDefault {
+            let slots = match slots {
+                Some(Ok(slots)) => slots.data,
+                Some(Err(error)) => {
+                    self.shutdown_control_failed(format!(
+                        "Could not verify the default account: {error}"
+                    ));
+                    return AppRunControl::Continue;
+                }
+                None => Vec::new(),
+            };
+            if !slots.iter().any(|slot| {
+                slot.is_default
+                    && snapshot
+                        .account
+                        .current
+                        .as_ref()
+                        .is_some_and(|account| account.account_slot_id == slot.account_slot_id)
+            }) {
+                self.shutdown_control_failed(
+                    "Logout is available only for the default account. Switch to the default account first."
+                        .to_string(),
+                );
+                return AppRunControl::Continue;
+            }
+        }
+        let Some(writer_generation) = snapshot.writer.writer_generation else {
+            self.shutdown_control_failed(
+                snapshot
+                    .writer
+                    .deny_reason
+                    .unwrap_or_else(|| "The session writer fence is unavailable.".to_string()),
+            );
+            return AppRunControl::Continue;
+        };
+        let operation_id = format!("tui-relinquish-{}", Uuid::new_v4());
+        self.pending_shutdown_exit = Some(PendingShutdownExit {
+            intent,
+            thread_id,
+            operation_id: operation_id.clone(),
+            instance_epoch: response.instance_epoch.clone(),
+            state_revision: snapshot.state_revision,
+            writer_generation,
+            released: false,
+            thread_closed: false,
+        });
+        let params = ThreadRelinquishParams {
+            operation_id: operation_id.clone(),
+            thread_id: thread_id.to_string(),
+            expected_instance_epoch: response.instance_epoch,
+            expected_state_revision: snapshot.state_revision,
+            expected_writer_generation: writer_generation,
+        };
+        let request_handle = app_server.request_handle();
+        let app_event_tx = self.app_event_tx.clone();
+        tokio::spawn(async move {
+            let result = relinquish_thread(request_handle, params)
+                .await
+                .map(|response| response.operation)
+                .map_err(|error| error.to_string());
+            app_event_tx.send(AppEvent::ShutdownRelinquishFinished {
+                operation_id,
+                result,
+            });
+        });
+        let app_event_tx = self.app_event_tx.clone();
+        let timeout_operation_id = self
+            .pending_shutdown_exit
+            .as_ref()
+            .map(|pending| pending.operation_id.clone())
+            .unwrap_or_default();
+        tokio::spawn(async move {
+            tokio::time::sleep(SHUTDOWN_RELEASE_TIMEOUT).await;
+            app_event_tx.send(AppEvent::ShutdownReleaseTimedOut {
+                operation_id: timeout_operation_id,
+            });
+        });
+        AppRunControl::Continue
+    }
+
+    pub(super) fn handle_shutdown_operation(
+        &mut self,
+        operation: &SessionRuntimeOperation,
+    ) -> bool {
+        let Some(pending) = self.pending_shutdown_exit.as_mut() else {
+            return false;
+        };
+        if !pending.matches_operation(operation) {
+            return false;
+        }
+        match operation.status {
+            SessionRuntimeOperationStatus::Released => pending.released = true,
+            SessionRuntimeOperationStatus::Failed => {
+                let message = operation
+                    .error
+                    .as_ref()
+                    .map(|error| error.message.clone())
+                    .unwrap_or_else(|| "Session release failed.".to_string());
+                self.shutdown_control_failed(message);
+                return true;
+            }
+            SessionRuntimeOperationStatus::Accepted | SessionRuntimeOperationStatus::Running => {}
+            SessionRuntimeOperationStatus::Ready => return false,
+        }
+        self.maybe_finish_pending_shutdown();
+        true
+    }
+
+    pub(super) fn handle_pending_shutdown_thread_closed(&mut self, thread_id: &str) -> bool {
+        let Some(pending) = self.pending_shutdown_exit.as_mut() else {
+            return false;
+        };
+        if pending.thread_id.to_string() != thread_id {
+            return false;
+        }
+        pending.thread_closed = true;
+        self.maybe_finish_pending_shutdown();
+        true
+    }
+
+    pub(super) fn handle_shutdown_relinquish_finished(
+        &mut self,
+        operation_id: &str,
+        result: Result<SessionRuntimeOperation, String>,
+    ) {
+        if self
+            .pending_shutdown_exit
+            .as_ref()
+            .is_none_or(|pending| pending.operation_id != operation_id)
+        {
+            return;
+        }
+        match result {
+            Ok(operation) => {
+                self.handle_shutdown_operation(&operation);
+            }
+            Err(error) => self.shutdown_control_failed(format!("Session release failed: {error}")),
+        }
+    }
+
+    pub(super) fn handle_shutdown_release_timeout(&mut self, operation_id: &str) {
+        let Some(pending) = self.pending_shutdown_exit.as_ref() else {
+            return;
+        };
+        if pending.operation_id != operation_id || pending.released && pending.thread_closed {
+            return;
+        }
+        tracing::warn!(
+            thread_id = %pending.thread_id,
+            instance_epoch = pending.instance_epoch,
+            state_revision = pending.state_revision,
+            writer_generation = pending.writer_generation,
+            released = pending.released,
+            thread_closed = pending.thread_closed,
+            "timed out waiting for verified session release"
+        );
+        self.chat_widget.add_info_message(
+            "Session release is still pending. Codex will exit after release completes."
+                .to_string(),
+            /*hint*/ None,
+        );
+        self.show_shutdown_waiting_picker();
+    }
+
+    fn maybe_finish_pending_shutdown(&mut self) {
+        let ready = self
+            .pending_shutdown_exit
+            .as_ref()
+            .is_some_and(|pending| pending.released && pending.thread_closed);
+        if !ready {
+            return;
+        }
+        let Some(pending) = self.pending_shutdown_exit.take() else {
+            return;
+        };
+        match pending.intent {
+            ShutdownIntent::Exit => self.app_event_tx.send(AppEvent::Exit(ExitMode::Immediate)),
+            ShutdownIntent::LogoutDefault => {
+                self.app_event_tx.send(AppEvent::LogoutAfterRelease);
+            }
+        }
+    }
+
+    pub(super) fn shutdown_control_failed(&mut self, message: String) {
+        self.shutdown_lookup_in_flight = false;
+        self.pending_shutdown_exit = None;
+        self.chat_widget.restore_after_shutdown_failure();
+        self.chat_widget.add_error_message(message);
+        self.show_shutdown_recovery_picker();
+    }
+
+    fn show_shutdown_recovery_picker(&mut self) {
+        self.chat_widget.show_selection_view(SelectionViewParams {
+            title: Some("Session is still open".to_string()),
+            subtitle: Some("Retry the safe release or exit immediately.".to_string()),
+            footer_hint: Some(standard_popup_hint_line()),
+            items: vec![
+                SelectionItem {
+                    name: "Retry safe exit".to_string(),
+                    actions: vec![Box::new(|tx| {
+                        tx.send(AppEvent::Exit(ExitMode::ShutdownFirst));
+                    })],
+                    dismiss_on_select: true,
+                    ..Default::default()
+                },
+                SelectionItem {
+                    name: "Exit immediately".to_string(),
+                    description: Some("Skip verified writer release".to_string()),
+                    actions: vec![Box::new(|tx| {
+                        tx.send(AppEvent::Exit(ExitMode::Immediate));
+                    })],
+                    dismiss_on_select: true,
+                    ..Default::default()
+                },
+                SelectionItem {
+                    name: "Stay in Codex".to_string(),
+                    dismiss_on_select: true,
+                    ..Default::default()
+                },
+            ],
+            ..Default::default()
+        });
+    }
+
+    fn show_shutdown_waiting_picker(&mut self) {
+        self.chat_widget.show_selection_view(SelectionViewParams {
+            title: Some("Waiting for session release".to_string()),
+            subtitle: Some("Input remains locked until the server operation finishes.".to_string()),
+            footer_hint: Some(standard_popup_hint_line()),
+            items: vec![SelectionItem {
+                name: "Keep waiting".to_string(),
+                dismiss_on_select: true,
+                ..Default::default()
+            }],
+            ..Default::default()
+        });
+    }
+
+    pub(super) fn begin_stock_logout(&self, app_server: &AppServerSession) {
+        let request_handle = app_server.request_handle();
+        let app_event_tx = self.app_event_tx.clone();
+        tokio::spawn(async move {
+            let result = logout_account_with_request_handle(request_handle)
+                .await
+                .map_err(|error| error.to_string());
+            app_event_tx.send(AppEvent::LogoutFinished { result });
+        });
+    }
+
+    pub(super) async fn handle_stock_shutdown(
+        &mut self,
+        app_server: &mut AppServerSession,
+        intent: ShutdownIntent,
+    ) -> AppRunControl {
+        if intent == ShutdownIntent::LogoutDefault
+            && let Err(error) = app_server.logout_account().await
+        {
+            self.shutdown_control_failed(format!("Logout failed: {error}"));
+            return AppRunControl::Continue;
+        }
+        self.shutdown_current_thread(app_server).await;
+        AppRunControl::Exit(ExitReason::UserRequested)
+    }
+}
