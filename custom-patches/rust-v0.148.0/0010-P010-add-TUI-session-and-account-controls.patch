+pub(crate) async fn session_runtime_for_thread(
+    request_handle: AppServerRequestHandle,
+    thread_id: ThreadId,
+) -> std::result::Result<SessionRuntimeLookup, TypedRequestError> {
+    let request_id = RequestId::String(format!("session-runtime-{}", Uuid::new_v4()));
+    let result = request_handle
+        .request_typed::<SessionRuntimeListResponse>(ClientRequest::SessionRuntimeList {
+            request_id,
+            params: SessionRuntimeListParams {
+                cursor: None,
+                limit: Some(1),
+                thread_id: Some(thread_id.to_string()),
+            },
+        })
+        .await;
+    match result {
+        Ok(response) => {
+            let supported = response.capabilities.iter().any(|capability| {
+                capability.name == SESSION_RUNTIME_CONTROL_CAPABILITY && capability.available
+            });
+            if supported {
+                Ok(SessionRuntimeLookup::Supported(response))
+            } else {
+                Ok(SessionRuntimeLookup::Unsupported)
+            }
+        }
+        Err(TypedRequestError::Server { source, .. })
+            if source.code == JSONRPC_METHOD_NOT_FOUND =>
+        {
+            Ok(SessionRuntimeLookup::Unsupported)
+        }
+        Err(error) => Err(error),
+    }
+}
