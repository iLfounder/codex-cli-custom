+pub(crate) async fn list_account_slots(
+    request_handle: AppServerRequestHandle,
+) -> std::result::Result<AccountSlotsSnapshot, TypedRequestError> {
+    let mut cursor = None;
+    let mut slots = Vec::new();
+    loop {
+        let request_id = RequestId::String(format!("account-slot-list-{}", Uuid::new_v4()));
+        let response: AccountSlotListResponse = request_handle
+            .request_typed(ClientRequest::AccountSlotList {
+                request_id,
+                params: AccountSlotListParams {
+                    cursor,
+                    limit: Some(100),
+                },
+            })
+            .await?;
+        slots.extend(response.data);
+        let multi_account = response.multi_account;
+        let Some(next_cursor) = response.next_cursor else {
+            return Ok(AccountSlotsSnapshot {
+                data: slots,
+                multi_account,
+            });
+        };
+        cursor = Some(next_cursor);
+    }
+}
