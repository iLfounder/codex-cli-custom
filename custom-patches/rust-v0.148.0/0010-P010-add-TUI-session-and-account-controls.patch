+//! Account-slot picker and same-thread account-switch flow.
+
+use super::*;
+use crate::app_server_session::SessionRuntimeLookup;
+use crate::app_server_session::list_account_slots;
+use crate::app_server_session::session_runtime_for_thread;
+use crate::app_server_session::start_account_slot_login;
+use crate::app_server_session::switch_thread_account;
+use codex_app_server_protocol::AccountSlotAction;
+use codex_app_server_protocol::AccountSlotCapability;
+use codex_app_server_protocol::AccountSlotLoginChallenge;
+use codex_app_server_protocol::AccountSlotLoginStartParams;
+use codex_app_server_protocol::AccountSlotLoginStartResponse;
+use codex_app_server_protocol::AccountSlotSnapshot;
+use codex_app_server_protocol::AccountSlotStatus;
+use codex_app_server_protocol::SessionRuntimeAccountSwitchState;
+use codex_app_server_protocol::SessionRuntimeAction;
+use codex_app_server_protocol::SessionRuntimeOperation;
+use codex_app_server_protocol::SessionRuntimeOperationStatus;
+use codex_app_server_protocol::SessionRuntimeSnapshot;
+use codex_app_server_protocol::ThreadAccountSwitchParams;
+
+const ACCOUNT_PICKER_VIEW_ID: &str = "account-picker";
+const ACCOUNT_LOGIN_VIEW_ID: &str = "account-login";
+
+#[derive(Debug)]
+pub(crate) struct AccountPickerSnapshot {
+    pub(crate) slots: Vec<AccountSlotSnapshot>,
+    pub(crate) capability: AccountSlotCapability,
+    pub(crate) runtime: Option<(String, SessionRuntimeSnapshot)>,
+}
+
+#[derive(Debug)]
+pub(super) struct PendingAccountSwitch {
+    operation_id: String,
+    source_thread_id: ThreadId,
+    target_slot_id: String,
+    ready_generation: Option<u64>,
+    validation_in_flight: bool,
+}
+
+impl PendingAccountSwitch {
+    fn matches_operation(&self, operation: &SessionRuntimeOperation) -> bool {
+        operation.operation_id == self.operation_id
+            && operation.thread_id.as_deref() == Some(self.source_thread_id.to_string().as_str())
+    }
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum AccountLoginMethod {
+    Browser,
+    DeviceCode,
+}
+
+impl App {
+    pub(super) fn open_account_picker(&mut self, app_server: &AppServerSession) {
+        let Some(thread_id) = self.current_displayed_thread_id() else {
+            self.chat_widget
+                .add_error_message("A session must start before choosing an account.".to_string());
+            return;
+        };
+        let request_generation = self.begin_account_picker_request();
+        self.chat_widget.show_selection_view(SelectionViewParams {
+            view_id: Some(ACCOUNT_PICKER_VIEW_ID),
+            title: Some("Accounts".to_string()),
+            subtitle: Some("Loading account slots...".to_string()),
+            items: vec![SelectionItem {
+                name: "Loading...".to_string(),
+                is_disabled: true,
+                ..Default::default()
+            }],
+            ..Default::default()
+        });
+        let request_handle = app_server.request_handle();
+        let runtime_handle = request_handle.clone();
+        let app_event_tx = self.app_event_tx.clone();
+        tokio::spawn(async move {
+            let (slots, runtime) = tokio::join!(
+                list_account_slots(request_handle),
+                session_runtime_for_thread(runtime_handle, thread_id)
+            );
+            let result = match (slots, runtime) {
+                (Ok(slots), Ok(SessionRuntimeLookup::Supported(runtime))) => {
+                    let runtime = runtime
+                        .data
+                        .into_iter()
+                        .find(|snapshot| snapshot.thread_id == thread_id.to_string())
+                        .map(|snapshot| (runtime.instance_epoch, snapshot));
+                    Ok(AccountPickerSnapshot {
+                        capability: slots.multi_account,
+                        slots: slots.data,
+                        runtime,
+                    })
+                }
+                (Ok(slots), Ok(SessionRuntimeLookup::Unsupported)) => Ok(AccountPickerSnapshot {
+                    capability: slots.multi_account,
+                    slots: slots.data,
+                    runtime: None,
+                }),
+                (Err(error), _) | (_, Err(error)) => Err(error.to_string()),
+            };
+            app_event_tx.send(AppEvent::AccountPickerLoaded {
+                thread_id,
+                request_generation,
+                result,
+            });
+        });
+    }
+
+    pub(super) fn handle_account_picker_loaded(
+        &mut self,
+        thread_id: ThreadId,
+        request_generation: u64,
+        result: Result<AccountPickerSnapshot, String>,
+    ) {
+        if request_generation != self.account_picker_request_generation {
+            return;
+        }
+        if self.current_displayed_thread_id() != Some(thread_id) {
+            if self
+                .pending_account_switch
+                .as_ref()
+                .is_some_and(|pending| pending.source_thread_id == thread_id)
+            {
+                self.pending_account_switch = None;
+            }
+            return;
+        }
+        if self
+            .pending_account_switch
+            .as_ref()
+            .is_some_and(|pending| pending.source_thread_id != thread_id)
+        {
+            self.pending_account_switch = None;
+        }
+        match result {
+            Ok(snapshot) => {
+                self.account_slots = snapshot.slots;
+                self.account_slot_capability = Some(snapshot.capability);
+                self.replace_account_runtime(snapshot.runtime);
+                if self
+                    .pending_account_switch
+                    .as_ref()
+                    .is_some_and(|pending| pending.validation_in_flight)
+                {
+                    let Some(pending) = self.pending_account_switch.take() else {
+                        return;
+                    };
+                    let switched = self.account_runtime.as_ref().is_some_and(|(_, runtime)| {
+                        runtime.account.switch_state == SessionRuntimeAccountSwitchState::Stable
+                            && runtime.account.current.as_ref().is_some_and(|current| {
+                                current.account_slot_id == pending.target_slot_id
+                                    && Some(current.execution_generation)
+                                        == pending.ready_generation
+                            })
+                    });
+                    if switched {
+                        self.chat_widget.add_info_message(
+                            "Account switched for the next turn.".to_string(),
+                            /*hint*/ None,
+                        );
+                    } else {
+                        self.chat_widget.add_error_message(
+                            "The account switch response did not match the refreshed runtime."
+                                .to_string(),
+                        );
+                    }
+                }
+                self.show_account_picker();
+            }
+            Err(error) => {
+                if self
+                    .pending_account_switch
+                    .as_ref()
+                    .is_some_and(|pending| pending.validation_in_flight)
+                {
+                    self.pending_account_switch = None;
+                }
+                self.chat_widget
+                    .add_error_message(format!("Could not load account slots: {error}"));
+            }
+        }
+    }
+
+    fn account_selection_view_params(&self) -> SelectionViewParams {
+        let current_slot_id = self
+            .account_runtime
+            .as_ref()
+            .and_then(|(_, runtime)| runtime.account.current.as_ref())
+            .map(|account| account.account_slot_id.as_str());
+        let switch_action = self.account_runtime.as_ref().and_then(|(_, runtime)| {
+            runtime
+                .actions
+                .iter()
+                .find(|action| action.action == SessionRuntimeAction::SwitchAccount)
+        });
+        let mut initial_selected_idx = None;
+        let mut items = Vec::with_capacity(self.account_slots.len() + 1);
+        for slot in &self.account_slots {
+            let is_current = current_slot_id == Some(slot.account_slot_id.as_str());
+            if is_current {
+                initial_selected_idx = Some(items.len());
+            }
+            let slot_id = slot.account_slot_id.clone();
+            let login_action = match slot.status {
+                AccountSlotStatus::LoginRequired => AccountSlotAction::Login,
+                AccountSlotStatus::Failed => AccountSlotAction::RetryLogin,
+                AccountSlotStatus::Ready => AccountSlotAction::SwitchTo,
+            };
+            let slot_action = slot
+                .actions
+                .iter()
+                .find(|action| action.action == login_action);
+            let (is_disabled, disabled_reason, action): (
+                _,
+                _,
+                Option<crate::bottom_pane::SelectionAction>,
+            ) = if is_current {
+                (true, Some("Current account".to_string()), None)
+            } else if slot.status == AccountSlotStatus::Ready {
+                let allowed = slot_action.is_some_and(|action| action.allowed)
+                    && switch_action.is_some_and(|action| action.allowed);
+                let reason = slot_action
+                    .and_then(|action| action.deny_reason.clone())
+                    .or_else(|| switch_action.and_then(|action| action.deny_reason.clone()));
+                let action = allowed.then(|| {
+                    Box::new(move |tx: &AppEventSender| {
+                        tx.send(AppEvent::SwitchAccountSlot {
+                            slot_id: slot_id.clone(),
+                        });
+                    }) as crate::bottom_pane::SelectionAction
+                });
+                (!allowed, reason, action)
+            } else {
+                let allowed = slot_action.is_some_and(|action| action.allowed)
+                    && slot.active_login_operation_id.is_none();
+                let reason = if slot.active_login_operation_id.is_some() {
+                    Some("Login in progress".to_string())
+                } else {
+                    slot_action.and_then(|action| action.deny_reason.clone())
+                };
+                let action = allowed.then(|| {
+                    Box::new(move |tx: &AppEventSender| {
+                        tx.send(AppEvent::OpenAccountLoginMethods {
+                            slot_id: Some(slot_id.clone()),
+                        });
+                    }) as crate::bottom_pane::SelectionAction
+                });
+                (!allowed, reason, action)
+            };
+            let status = match slot.status {
+                AccountSlotStatus::LoginRequired => "Login required",
+                AccountSlotStatus::Ready => "Ready",
+                AccountSlotStatus::Failed => "Login failed",
+            };
+            items.push(SelectionItem {
+                name: slot.label.clone(),
+                description: Some(status.to_string()),
+                is_current,
+                is_default: slot.is_default,
+                is_disabled,
+                disabled_reason,
+                actions: action.into_iter().collect(),
+                dismiss_on_select: true,
+                ..Default::default()
+            });
+        }
+        let multi_account = self.account_slot_capability.as_ref();
+        let add_allowed = multi_account.is_some_and(|capability| capability.available);
+        items.push(SelectionItem {
+            name: "Add account".to_string(),
+            description: Some("Sign in with a browser or device code".to_string()),
+            is_disabled: !add_allowed,
+            disabled_reason: multi_account.and_then(|capability| capability.deny_reason.clone()),
+            actions: add_allowed
+                .then(|| {
+                    Box::new(|tx: &AppEventSender| {
+                        tx.send(AppEvent::OpenAccountLoginMethods { slot_id: None });
+                    }) as crate::bottom_pane::SelectionAction
+                })
+                .into_iter()
+                .collect(),
+            dismiss_on_select: true,
+            ..Default::default()
+        });
+        SelectionViewParams {
+            view_id: Some(ACCOUNT_PICKER_VIEW_ID),
+            title: Some("Accounts".to_string()),
+            subtitle: Some("Choose the account used by the next turn.".to_string()),
+            footer_hint: Some(standard_popup_hint_line()),
+            items,
+            initial_selected_idx,
+            ..Default::default()
+        }
+    }
+
+    fn show_account_picker(&mut self) {
+        let params = self.account_selection_view_params();
+        if !self
+            .chat_widget
+            .replace_selection_view_if_present(ACCOUNT_PICKER_VIEW_ID, params)
+        {
+            self.chat_widget
+                .show_selection_view(self.account_selection_view_params());
+        }
+    }
+
+    fn refresh_account_picker_if_present(&mut self) {
+        let params = self.account_selection_view_params();
+        self.chat_widget
+            .replace_selection_view_if_present(ACCOUNT_PICKER_VIEW_ID, params);
+    }
+
+    pub(super) fn show_account_login_methods(&mut self, slot_id: Option<String>) {
+        let browser_slot = slot_id.clone();
+        self.chat_widget.show_selection_view(SelectionViewParams {
+            view_id: Some(ACCOUNT_LOGIN_VIEW_ID),
+            title: Some("Add account".to_string()),
+            subtitle: Some("Choose a sign-in method.".to_string()),
+            footer_hint: Some(standard_popup_hint_line()),
+            items: vec![
+                SelectionItem {
+                    name: "Continue in browser".to_string(),
+                    actions: vec![Box::new(move |tx| {
+                        tx.send(AppEvent::StartAccountSlotLogin {
+                            slot_id: browser_slot.clone(),
+                            method: AccountLoginMethod::Browser,
+                        });
+                    })],
+                    dismiss_on_select: true,
+                    ..Default::default()
+                },
+                SelectionItem {
+                    name: "Use device code".to_string(),
+                    actions: vec![Box::new(move |tx| {
+                        tx.send(AppEvent::StartAccountSlotLogin {
+                            slot_id: slot_id.clone(),
+                            method: AccountLoginMethod::DeviceCode,
+                        });
+                    })],
+                    dismiss_on_select: true,
+                    ..Default::default()
+                },
+            ],
+            ..Default::default()
+        });
+    }
+
+    pub(super) fn start_account_login(
+        &mut self,
+        app_server: &AppServerSession,
+        slot_id: Option<String>,
+        method: AccountLoginMethod,
+    ) {
+        let params = match method {
+            AccountLoginMethod::Browser => AccountSlotLoginStartParams::Chatgpt {
+                slot_id,
+                codex_streamlined_login: false,
+                use_hosted_login_success_page: false,
+                app_brand: None,
+            },
+            AccountLoginMethod::DeviceCode => {
+                AccountSlotLoginStartParams::ChatgptDeviceCode { slot_id }
+            }
+        };
+        let request_handle = app_server.request_handle();
+        let app_event_tx = self.app_event_tx.clone();
+        tokio::spawn(async move {
+            let result = start_account_slot_login(request_handle, params)
+                .await
+                .map_err(|error| error.to_string());
+            app_event_tx.send(AppEvent::AccountSlotLoginStarted { result });
+        });
+    }
+
+    pub(super) fn handle_account_slot_login_started(
+        &mut self,
+        result: Result<AccountSlotLoginStartResponse, String>,
+    ) {
+        match result {
+            Ok(response) => {
+                self.upsert_account_slot(response.slot);
+                match response.challenge {
+                    Some(AccountSlotLoginChallenge::Browser { auth_url, .. }) => {
+                        self.open_url_in_browser(auth_url);
+                    }
+                    Some(AccountSlotLoginChallenge::DeviceCode {
+                        verification_url,
+                        user_code,
+                        ..
+                    }) => {
+                        self.chat_widget.add_info_message(
+                            format!("Open {verification_url} and enter code {user_code}."),
+                            /*hint*/ None,
+                        );
+                    }
+                    None => {}
+                }
+                self.show_account_picker();
+            }
+            Err(error) => self
+                .chat_widget
+                .add_error_message(format!("Account login failed: {error}")),
+        }
+    }
+
+    pub(super) fn handle_account_slot_changed(&mut self, slot: AccountSlotSnapshot) {
+        self.upsert_account_slot(slot);
+        self.refresh_account_picker_if_present();
+    }
+
+    fn upsert_account_slot(&mut self, slot: AccountSlotSnapshot) {
+        if let Some(existing) = self
+            .account_slots
+            .iter_mut()
+            .find(|existing| existing.account_slot_id == slot.account_slot_id)
+        {
+            *existing = slot;
+        } else {
+            self.account_slots.push(slot);
+        }
+    }
+
+    pub(super) fn switch_account_slot(&mut self, app_server: &AppServerSession, slot_id: String) {
+        let Some(source_thread_id) = self.current_displayed_thread_id() else {
+            self.chat_widget
+                .add_error_message("The current session is unavailable.".to_string());
+            return;
+        };
+        let Some((instance_epoch, runtime)) = self.account_runtime.as_ref() else {
+            self.chat_widget.add_error_message(
+                "Account switching is not supported by this server.".to_string(),
+            );
+            return;
+        };
+        if runtime.thread_id != source_thread_id.to_string() {
+            self.chat_widget.add_error_message(
+                "The account runtime no longer matches the displayed session.".to_string(),
+            );
+            return;
+        }
+        let Some(current) = runtime.account.current.as_ref() else {
+            self.chat_widget
+                .add_error_message("The current account binding is unavailable.".to_string());
+            return;
+        };
+        let operation_id = format!("tui-account-switch-{}", Uuid::new_v4());
+        self.pending_account_switch = Some(PendingAccountSwitch {
+            operation_id: operation_id.clone(),
+            source_thread_id,
+            target_slot_id: slot_id.clone(),
+            ready_generation: None,
+            validation_in_flight: false,
+        });
+        let params = ThreadAccountSwitchParams {
+            operation_id: operation_id.clone(),
+            thread_id: runtime.thread_id.clone(),
+            target_account_slot_id: slot_id,
+            expected_instance_epoch: instance_epoch.clone(),
+            expected_state_revision: runtime.state_revision,
+            expected_execution_generation: current.execution_generation,
+        };
+        let request_handle = app_server.request_handle();
+        let app_event_tx = self.app_event_tx.clone();
+        tokio::spawn(async move {
+            let result = switch_thread_account(request_handle, params)
+                .await
+                .map(|response| response.operation)
+                .map_err(|error| error.to_string());
+            app_event_tx.send(AppEvent::AccountSwitchFinished {
+                operation_id,
+                result,
+            });
+        });
+    }
+
+    pub(super) fn handle_account_switch_finished(
+        &mut self,
+        app_server: &AppServerSession,
+        operation_id: String,
+        result: Result<SessionRuntimeOperation, String>,
+    ) {
+        let pending_is_current = self.pending_account_switch.as_ref().is_some_and(|pending| {
+            pending.operation_id == operation_id
+                && self.current_displayed_thread_id() == Some(pending.source_thread_id)
+        });
+        if !pending_is_current {
+            if self
+                .pending_account_switch
+                .as_ref()
+                .is_some_and(|pending| pending.operation_id == operation_id)
+            {
+                self.pending_account_switch = None;
+            }
+            return;
+        }
+        match result {
+            Ok(operation)
+                if operation.status == SessionRuntimeOperationStatus::Ready
+                    && self
+                        .pending_account_switch
+                        .as_ref()
+                        .is_some_and(|pending| pending.matches_operation(&operation)) =>
+            {
+                if let Some(pending) = self.pending_account_switch.as_mut()
+                    && pending.operation_id == operation_id
+                {
+                    self.begin_account_switch_validation(
+                        app_server,
+                        operation.execution_generation,
+                    );
+                }
+            }
+            Ok(operation) => {
+                self.pending_account_switch = None;
+                let message = operation
+                    .error
+                    .map(|error| error.message)
+                    .unwrap_or_else(|| "Account switch did not complete.".to_string());
+                self.chat_widget.add_error_message(message);
+                self.open_account_picker(app_server);
+            }
+            Err(error) => {
+                self.pending_account_switch = None;
+                self.chat_widget
+                    .add_error_message(format!("Account switch failed: {error}"));
+                self.open_account_picker(app_server);
+            }
+        }
+    }
+
+    pub(super) fn handle_account_switch_operation(
+        &mut self,
+        app_server: &AppServerSession,
+        operation: &SessionRuntimeOperation,
+    ) -> bool {
+        let current_thread_id = self.current_displayed_thread_id();
+        let Some(pending) = self.pending_account_switch.as_mut() else {
+            return false;
+        };
+        if !pending.matches_operation(operation) {
+            return false;
+        }
+        if current_thread_id != Some(pending.source_thread_id) {
+            self.pending_account_switch = None;
+            return true;
+        }
+        match operation.status {
+            SessionRuntimeOperationStatus::Ready => {
+                self.begin_account_switch_validation(app_server, operation.execution_generation);
+            }
+            SessionRuntimeOperationStatus::Failed => {
+                let message = operation
+                    .error
+                    .as_ref()
+                    .map(|error| error.message.clone())
+                    .unwrap_or_else(|| "Account switch failed.".to_string());
+                self.pending_account_switch = None;
+                self.chat_widget.add_error_message(message);
+                self.open_account_picker(app_server);
+            }
+            SessionRuntimeOperationStatus::Accepted | SessionRuntimeOperationStatus::Running => {}
+            SessionRuntimeOperationStatus::Released => return false,
+        }
+        true
+    }
+
+    fn begin_account_switch_validation(
+        &mut self,
+        app_server: &AppServerSession,
+        execution_generation: Option<u64>,
+    ) {
+        let Some(execution_generation) = execution_generation else {
+            self.pending_account_switch = None;
+            self.chat_widget.add_error_message(
+                "The account switch response did not include an execution generation.".to_string(),
+            );
+            return;
+        };
+        let Some(pending) = self.pending_account_switch.as_mut() else {
+            return;
+        };
+        if let Some(ready_generation) = pending.ready_generation
+            && ready_generation != execution_generation
+        {
+            self.pending_account_switch = None;
+            self.chat_widget.add_error_message(
+                "The account switch completed with inconsistent execution generations.".to_string(),
+            );
+            return;
+        }
+        pending.ready_generation = Some(execution_generation);
+        if pending.validation_in_flight {
+            return;
+        }
+        pending.validation_in_flight = true;
+        self.open_account_picker(app_server);
+    }
+
+    pub(super) fn handle_account_runtime_changed(
+        &mut self,
+        instance_epoch: String,
+        snapshot: SessionRuntimeSnapshot,
+    ) {
+        let is_current = self
+            .current_displayed_thread_id()
+            .is_some_and(|thread_id| snapshot.thread_id == thread_id.to_string());
+        if !is_current {
+            return;
+        }
+        if self
+            .pending_account_switch
+            .as_ref()
+            .is_some_and(|pending| pending.source_thread_id.to_string() != snapshot.thread_id)
+        {
+            self.pending_account_switch = None;
+        }
+        self.replace_account_runtime(Some((instance_epoch, snapshot)));
+        self.refresh_account_picker_if_present();
+    }
+
+    fn replace_account_runtime(&mut self, runtime: Option<(String, SessionRuntimeSnapshot)>) {
+        self.account_runtime = runtime;
+    }
+    pub(super) fn begin_account_picker_request(&mut self) -> u64 {
+        self.account_picker_request_generation =
+            self.account_picker_request_generation.saturating_add(1);
+        self.account_picker_request_generation
+    }
+}
