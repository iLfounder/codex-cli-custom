+#[tokio::test]
+async fn shutdown_exit_requires_matching_release_and_thread_closed() {
+    let (mut app, mut app_event_rx, _op_rx) = make_test_app_with_channels().await;
+    let thread_id = ThreadId::new();
+    app.pending_shutdown_exit = Some(test_pending_shutdown(thread_id));
+
+    assert!(app.handle_shutdown_operation(&test_relinquish_operation(
+        thread_id,
+        codex_app_server_protocol::SessionRuntimeOperationStatus::Released,
+    )));
+    assert!(app_event_rx.try_recv().is_err());
+    assert!(app.handle_pending_shutdown_thread_closed(&thread_id.to_string()));
+    assert_matches!(
+        app_event_rx.try_recv(),
+        Ok(AppEvent::Exit(ExitMode::Immediate))
+    );
+    assert!(app.pending_shutdown_exit.is_none());
+}
+
+#[tokio::test]
+async fn shutdown_timeout_keeps_pending_and_accepts_late_terminals() {
+    let (mut app, mut app_event_rx, _op_rx) = make_test_app_with_channels().await;
+    let thread_id = ThreadId::new();
+    app.pending_shutdown_exit = Some(test_pending_shutdown(thread_id));
+
+    app.handle_shutdown_release_timeout("test-operation");
+
+    assert!(app.pending_shutdown_exit.is_some());
+    assert_app_snapshot!(
+        "shutdown_release_waiting_after_timeout",
+        render_bottom_popup(&app.chat_widget, /*width*/ 80)
+    );
+    while let Ok(event) = app_event_rx.try_recv() {
+        assert!(!matches!(event, AppEvent::Exit(_)));
+    }
+    assert!(app.handle_shutdown_operation(&test_relinquish_operation(
+        thread_id,
+        codex_app_server_protocol::SessionRuntimeOperationStatus::Released,
+    )));
+    assert!(app_event_rx.try_recv().is_err());
+    assert!(app.handle_pending_shutdown_thread_closed(&thread_id.to_string()));
+    assert_matches!(
+        app_event_rx.try_recv(),
+        Ok(AppEvent::Exit(ExitMode::Immediate))
+    );
+    assert!(app.pending_shutdown_exit.is_none());
+}
