+    let slot: codex_app_server_protocol::AccountSlotSnapshot =
+        serde_json::from_value(serde_json::json!({
+        "accountSlotId": "slot-secondary",
+        "label": "Secondary",
+        "isDefault": false,
+        "status": "ready",
+        "authMode": null,
+        "attemptGeneration": 1,
+        "registryRevision": 2,
+        "activeLoginOperationId": null,
+        "errorCode": null,
+        "actions": [],
+        "updatedAt": 1
+        }))?;
+    let snapshot = || account_picker::AccountPickerSnapshot {
+        slots: vec![slot.clone()],
+        capability: codex_app_server_protocol::AccountSlotCapability {
+            available: true,
+            deny_reason: None,
+        },
+        runtime: None,
+    };
+
+    let stale_generation = app.begin_account_picker_request();
+    let latest_generation = app.begin_account_picker_request();
+    app.handle_account_picker_loaded(displayed_thread_id, stale_generation, Ok(snapshot()));
+    assert!(app.account_slots.is_empty());
+
+    let wrong_thread_generation = app.begin_account_picker_request();
+    app.handle_account_picker_loaded(other_thread_id, wrong_thread_generation, Ok(snapshot()));
+    assert!(app.account_slots.is_empty());
+
+    let current_generation = app.begin_account_picker_request();
+    app.handle_account_picker_loaded(displayed_thread_id, latest_generation, Ok(snapshot()));
+    assert!(app.account_slots.is_empty());
+
+    app.handle_account_picker_loaded(displayed_thread_id, current_generation, Ok(snapshot()));
+    assert_eq!(app.account_slots, vec![slot]);
+    Ok(())
+}
