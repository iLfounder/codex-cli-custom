+#[test]
+fn operation_updates_do_not_regress_terminal_states() {
+    assert!(valid_operation_transition(
+        SessionRuntimeOperationStatus::Accepted,
+        SessionRuntimeOperationStatus::Running,
+    ));
+    assert!(valid_operation_transition(
+        SessionRuntimeOperationStatus::Running,
+        SessionRuntimeOperationStatus::Ready,
+    ));
+    assert!(!valid_operation_transition(
+        SessionRuntimeOperationStatus::Ready,
+        SessionRuntimeOperationStatus::Running,
+    ));
+    assert!(valid_operation_transition(
+        SessionRuntimeOperationStatus::Ready,
+        SessionRuntimeOperationStatus::Failed,
+    ));
+
+    let mut left = SessionRuntimeOperation {
+        operation_id: "operation-a".to_string(),
+        request_fingerprint: "fingerprint-a".to_string(),
+        action: SessionRuntimeOperationAction::AccountSlotLogin,
+        status: SessionRuntimeOperationStatus::Accepted,
+        thread_id: None,
+        account_slot_id: Some("slot-a".to_string()),
+        state_revision: None,
+        writer_generation: None,
+        execution_generation: Some(1),
+        error: None,
+        updated_at: 1,
+    };
+    let mut right = left.clone();
+    assert!(same_operation_identity(&left, &right));
+    right.account_slot_id = Some("slot-b".to_string());
+    assert!(!same_operation_identity(&left, &right));
+    left.status = SessionRuntimeOperationStatus::Ready;
+    assert!(is_terminal_operation(left.status));
+}
