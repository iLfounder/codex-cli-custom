+#[tokio::test]
+async fn paginated_progress_tracks_exact_durable_position_across_resume() -> std::io::Result<()> {
+    let home = TempDir::new().expect("temp dir");
+    let config = test_config(home.path());
+    let recorder = RolloutRecorder::new(
+        &config,
+        RolloutRecorderParams::new(
+            ThreadId::new(),
+            /*forked_from_id*/ None,
+            /*parent_thread_id*/ None,
+            SessionSource::Exec,
+            /*thread_source*/ None,
+            "test_originator".to_string(),
+            BaseInstructions::default(),
+            Vec::new(),
+        )
+        .with_history_mode(ThreadHistoryMode::Paginated),
+    )
+    .await?;
+    let rollout_path = recorder.rollout_path().to_path_buf();
+
+    assert_eq!(recorder.progress().await?, None);
+    recorder.persist().await?;
+    let session_meta_progress = recorder.progress().await?.expect("session meta progress");
+    assert_eq!(session_meta_progress.end_ordinal_exclusive, 1);
+    assert_eq!(
+        session_meta_progress.end_byte_offset,
+        fs::metadata(&rollout_path)?.len()
+    );
+
+    recorder
+        .record_canonical_items(&[agent_message_item("durable record")])
+        .await?;
+    recorder.flush().await?;
+    let appended_progress = recorder.progress().await?.expect("appended progress");
+    assert_eq!(appended_progress.end_ordinal_exclusive, 2);
+    assert_eq!(
+        appended_progress.end_byte_offset,
+        fs::metadata(&rollout_path)?.len()
+    );
+    recorder.shutdown().await?;
+
+    let resumed =
+        RolloutRecorder::new(&config, RolloutRecorderParams::resume(rollout_path.clone())).await?;
+    assert_eq!(resumed.progress().await?, Some(appended_progress));
+    resumed.shutdown().await
+}
