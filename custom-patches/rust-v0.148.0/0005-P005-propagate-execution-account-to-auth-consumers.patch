+struct FixedExecutionAccountResolver(Arc<ExecutionAccountContext>);
+
+impl ExecutionAccountResolver for FixedExecutionAccountResolver {
+    fn resolve(
+        &self,
+        binding: ExecutionAccountBinding,
+    ) -> crate::ExecutionAccountResolverFuture<'_> {
+        let context = Arc::clone(&self.0);
+        Box::pin(async move {
+            if binding != context.binding {
+                return Err(codex_protocol::error::CodexErr::InvalidRequest(
+                    "unexpected execution account binding".to_string(),
+                ));
+            }
+            Ok(context)
+        })
+    }
+}
