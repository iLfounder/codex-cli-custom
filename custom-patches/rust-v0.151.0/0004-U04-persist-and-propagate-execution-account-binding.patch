+    assert!(Arc::ptr_eq(
+        &second_services.plugins_manager,
+        &second_services_again.plugins_manager,
+    ));
+    assert!(Arc::ptr_eq(
+        &second_services.mcp_manager,
+        &second_services_again.mcp_manager,
