diff --git a/codex-rs/app-server-protocol/schema/json/v2/AccountSlotLogoutResponse.json b/codex-rs/app-server-protocol/schema/json/v2/AccountSlotLogoutResponse.json
new file mode 100644
index 0000000000000000000000000000000000000000..e3b1185d21ff329468e4f495ac0dc60e839c030e
--- /dev/null
+++ b/codex-rs/app-server-protocol/schema/json/v2/AccountSlotLogoutResponse.json
@@ -0,0 +1,178 @@
+{
+  "$schema": "http://json-schema.org/draft-07/schema#",
+  "definitions": {
+    "AccountSlotAction": {
+      "enum": [
+        "login",
+        "retryLogin",
+        "switchTo",
+        "logout"
+      ],
+      "type": "string"
+    },
+    "AccountSlotActionAvailability": {
+      "properties": {
+        "action": {
+          "$ref": "#/definitions/AccountSlotAction"
+        },
+        "allowed": {
+          "type": "boolean"
+        },
+        "denyReason": {
+          "type": [
+            "string",
+            "null"
+          ]
+        }
+      },
+      "required": [
+        "action",
+        "allowed"
+      ],
+      "type": "object"
+    },
+    "AccountSlotSnapshot": {
+      "description": "A host-managed account slot without credential paths, email addresses, or tokens.",
+      "properties": {
+        "accountSlotId": {
+          "type": "string"
+        },
+        "actions": {
+          "items": {
+            "$ref": "#/definitions/AccountSlotActionAvailability"
+          },
+          "type": "array"
+        },
+        "activeLoginOperationId": {
+          "type": [
+            "string",
+            "null"
+          ]
+        },
+        "attemptGeneration": {
+          "format": "uint64",
+          "minimum": 0.0,
+          "type": "integer"
+        },
+        "authMode": {
+          "anyOf": [
+            {
+              "$ref": "#/definitions/AuthMode"
+            },
+            {
+              "type": "null"
+            }
+          ]
+        },
+        "errorCode": {
+          "type": [
+            "string",
+            "null"
+          ]
+        },
+        "isDefault": {
+          "type": "boolean"
+        },
+        "label": {
+          "type": "string"
+        },
+        "registryRevision": {
+          "format": "uint64",
+          "minimum": 0.0,
+          "type": "integer"
+        },
+        "status": {
+          "$ref": "#/definitions/AccountSlotStatus"
+        },
+        "updatedAt": {
+          "description": "Unix timestamp in seconds when the slot last changed.",
+          "format": "int64",
+          "type": "integer"
+        }
+      },
+      "required": [
+        "accountSlotId",
+        "actions",
+        "attemptGeneration",
+        "isDefault",
+        "label",
+        "registryRevision",
+        "status",
+        "updatedAt"
+      ],
+      "type": "object"
+    },
+    "AccountSlotStatus": {
+      "enum": [
+        "loginRequired",
+        "ready",
+        "failed"
+      ],
+      "type": "string"
+    },
+    "AuthMode": {
+      "description": "Authentication mode for OpenAI-backed providers.",
+      "oneOf": [
+        {
+          "description": "OpenAI API key provided by the caller and stored by Codex.",
+          "enum": [
+            "apikey"
+          ],
+          "type": "string"
+        },
+        {
+          "description": "ChatGPT OAuth managed by Codex (tokens persisted and refreshed by Codex).",
+          "enum": [
+            "chatgpt"
+          ],
+          "type": "string"
+        },
+        {
+          "description": "[UNSTABLE] FOR OPENAI INTERNAL USE ONLY - DO NOT USE.\n\nChatGPT auth tokens are supplied by an external host app and are only stored in memory. Token refresh must be handled by the external host app.",
+          "enum": [
+            "chatgptAuthTokens"
+          ],
+          "type": "string"
+        },
+        {
+          "description": "Backend auth supplied as request headers.",
+          "enum": [
+            "headers"
+          ],
+          "type": "string"
+        },
+        {
+          "description": "Programmatic Codex auth backed by a registered Agent Identity.",
+          "enum": [
+            "agentIdentity"
+          ],
+          "type": "string"
+        },
+        {
+          "description": "Programmatic Codex auth backed by a personal access token.",
+          "enum": [
+            "personalAccessToken"
+          ],
+          "type": "string"
+        },
+        {
+          "description": "Amazon Bedrock bearer token managed by Codex.",
+          "enum": [
+            "bedrockApiKey"
+          ],
+          "type": "string"
+        }
+      ]
+    }
+  },
+  "properties": {
+    "slot": {
+      "$ref": "#/definitions/AccountSlotSnapshot"
+    }
+  },
+  "required": [
+    "slot"
+  ],
+  "title": "AccountSlotLogoutResponse",
+  "type": "object"
+}
\ No newline at end of file
