+    let temp = TempDir::new().expect("temp dir");
+    let socket_path = AbsolutePathBuf::from_absolute_path(temp.path().join("app.sock"))
+        .expect("socket path should resolve");
+    let (_init_gate_tx, init_gate_rx) = watch::channel(true);
