@@ -0,0 +1,268 @@
+use codex_protocol::ThreadId;
+use codex_protocol::protocol::ExecutionAccountBinding;
+use codex_utils_absolute_path::test_support::PathExt;
+use pretty_assertions::assert_eq;
+
+use crate::AccountBindingCommitIntent;
