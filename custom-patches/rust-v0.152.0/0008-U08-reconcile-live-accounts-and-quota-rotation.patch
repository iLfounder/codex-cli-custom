+            default_model_provider_id: "test-provider".to_string(),
+        },
+        Some(runtime.clone()),
+    );
+    let thread_id = ThreadId::default();
+    let initial = ExecutionAccountBinding {
+        slot_id: "default".to_string(),
+        generation: 1,
+    };
+    store
