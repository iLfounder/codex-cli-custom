+
+impl DefaultLoginCompletion {
+    async fn wait(&self) {
+        let notified = self.notify.notified();
+        if !self.completed.load(Ordering::Acquire) {
+            notified.await;
+        }
+    }
+
+    fn complete(&self) {
+        self.completed.store(true, Ordering::Release);
+        self.notify.notify_waiters();
+    }
 }
 
