+    ) -> anyhow::Result<ThreadTransitionAbortOutcome> {
+        let mut transaction = self.pool.begin_with("BEGIN IMMEDIATE").await?;
+        let Some(row) = transition_row_by_id(&mut *transaction, &request.transition_id).await?
+        else {
