+fn meter(id: &str, utilization: f64, reset_at: i64, observed_at: i64) -> RawMeter {
+    RawMeter {
+        id: id.to_string(),
+        label: id.to_uppercase(),
+        utilization,
+        reset_at,
+        observed_at,
+        utilization_observed_at: observed_at,
+        state: "normal".to_string(),
+    }
+}
