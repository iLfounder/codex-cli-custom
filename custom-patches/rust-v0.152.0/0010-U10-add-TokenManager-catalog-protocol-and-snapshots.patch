+fn snapshot(
+    label: &str,
+    fetched_at: i64,
+    source_ref: &str,
+    utilization: f64,
+    reset_at: i64,
+) -> RawSnapshot {
+    RawSnapshot {
+        label: label.to_string(),
+        provider_type: "codex-chatgpt".to_string(),
+        source_ref: Some(source_ref.to_string()),
+        fetched_at,
+        ok: true,
+        rate_limit: Some(RawRateLimit {
+            meters: vec![meter("7d", utilization, reset_at, fetched_at)],
+            status: "allowed".to_string(),
+        }),
