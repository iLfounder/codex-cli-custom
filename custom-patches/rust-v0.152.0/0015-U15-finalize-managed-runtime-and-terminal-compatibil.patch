+            return Err(ManagedAccountCatalogError::UnsafeFile);
+        }
+    }
     if contents.len() as u64 > MAX_ACCOUNT_REGISTRY_BYTES {
         return Err(ManagedAccountCatalogError::TooLarge);
     }
