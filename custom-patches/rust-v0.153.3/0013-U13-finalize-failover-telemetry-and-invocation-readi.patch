+        self.inner
+            .candidate
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .binding
+            .clone()
+    }
+
+    pub(super) fn policy_revision(&self) -> Option<u64> {
+        self.inner
+            .candidate
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .policy_revision
+    }
+
+    #[expect(
