+async fn start_turn_with_account_rotation<C>(
+    client: &C,
+    request_ids: &mut RequestIdSequencer,
+    account_rotation: Option<(&str, cli::AccountRotation)>,
+    params: TurnStartParams,
+) -> Result<TurnStartResponse, String>
+where
