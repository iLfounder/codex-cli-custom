+#[derive(Debug, Clone, Copy, Default, PartialEq, Eq, ValueEnum)]
+#[value(rename_all = "kebab-case")]
+pub enum AccountFailover {
+    #[default]
+    Disabled,
+    PreSemantic,
+}
