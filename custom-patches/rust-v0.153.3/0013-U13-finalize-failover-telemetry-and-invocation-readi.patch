+{
+    if let Some((thread_id, mode)) = account_rotation {
+        bootstrap_account_rotation(client, request_ids, thread_id, mode).await?;
+    }
+    send_exec_request_with_response(
+        client,
+        ClientRequest::TurnStart {
+            request_id: request_ids.next(),
