+        "--message=two words".to_string(),
+        "semi;colon".to_string(),
+        "$HOME".to_string(),
+        String::new(),
+    ];
+
+    assert_eq!(
+        plugin_hook_command(&command),
+        "'/tmp/plugin runner' '--message=two words' 'semi;colon' '$HOME' ''"
+    );
+}
