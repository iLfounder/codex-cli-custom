+    let authorization = requests
+        .last()
+        .and_then(|request| request.headers.get("authorization"))
+        .and_then(|value| value.to_str().ok());
+    assert_eq!(authorization, Some("Bearer replacement-secondary-key"));
+    Ok(())
+}
