+{
+  "$schema": "http://json-schema.org/draft-07/schema#",
+  "definitions": {
+    "SessionRuntimeOperation": {
+      "description": "Common operation state returned by controls and published as progress changes.",
+      "properties": {
+        "accountSlotId": {
+          "type": [
+            "string",
+            "null"
+          ]
+        },
+        "action": {
+          "$ref": "#/definitions/SessionRuntimeOperationAction"
+        },
+        "error": {
+          "anyOf": [
+            {
+              "$ref": "#/definitions/SessionRuntimeOperationError"
+            },
+            {
+              "type": "null"
+            }
+          ]
+        },
+        "executionGeneration": {
+          "format": "uint64",
+          "minimum": 0.0,
+          "type": [
+            "integer",
+            "null"
+          ]
+        },
+        "operationId": {
+          "type": "string"
+        },
+        "requestFingerprint": {
+          "description": "Opaque digest of the normalized action and arguments. Reusing an operation id with a different fingerprint is an invalid request rather than an idempotent retry.",
+          "type": "string"
+        },
+        "stateRevision": {
+          "format": "uint64",
+          "minimum": 0.0,
+          "type": [
+            "integer",
+            "null"
+          ]
+        },
+        "status": {
+          "$ref": "#/definitions/SessionRuntimeOperationStatus"
+        },
+        "threadId": {
+          "type": [
+            "string",
+            "null"
+          ]
+        },
+        "updatedAt": {
+          "description": "Unix timestamp in seconds when this operation state was produced.",
+          "format": "int64",
+          "type": "integer"
+        },
+        "writerGeneration": {
+          "format": "uint64",
+          "minimum": 0.0,
+          "type": [
+            "integer",
+            "null"
+          ]
+        }
+      },
+      "required": [
+        "action",
+        "operationId",
+        "requestFingerprint",
+        "status",
+        "updatedAt"
+      ],
+      "type": "object"
+    },
+    "SessionRuntimeOperationAction": {
+      "enum": [
+        "accountSlotLogin",
+        "threadAccountSwitch",
+        "threadRelinquish"
+      ],
+      "type": "string"
