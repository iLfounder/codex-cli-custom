+      "required": [
+        "code",
+        "message"
+      ],
+      "type": "object"
+    },
+    "SessionRuntimeOperationStatus": {
+      "enum": [
+        "accepted",
+        "running",
+        "released",
+        "ready",
+        "failed"
+      ],
+      "type": "string"
+    }
+  },
+  "description": "Progress or terminal state for a bounded process-local operation.",
+  "properties": {
+    "instanceEpoch": {
+      "type": "string"
+    },
+    "operation": {
+      "$ref": "#/definitions/SessionRuntimeOperation"
+    },
+    "sequence": {
+      "format": "uint64",
+      "minimum": 0.0,
+      "type": "integer"
+    }
+  },
+  "required": [
+    "instanceEpoch",
+    "operation",
+    "sequence"
+  ],
