+struct ConfiguredAdapter {
+    rows: Vec<TuiFooterRow>,
+    colors: BTreeMap<TuiFooterVariable, TuiFooterColor>,
+}
+
+impl FooterAdapter for ConfiguredAdapter {
+    fn id(&self) -> &'static str {
