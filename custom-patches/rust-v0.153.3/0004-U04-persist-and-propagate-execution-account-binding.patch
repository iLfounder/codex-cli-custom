+            crate::api::GoalTokenBudgetUpdate::Set(token_budget) => {
+                let token_budget = token_budget.or(max_goal_token_budget);
+                validate_goal_budget(token_budget, max_goal_token_budget)
+                    .map_err(GoalServiceError::InvalidRequest)?;
+                Some(token_budget)
+            }
+        };
