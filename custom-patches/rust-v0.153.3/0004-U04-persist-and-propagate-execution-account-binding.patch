+        .thread_goals()
+        .clear_thread_goal_exact(thread_id, &codex_state::GoalVersion::from(&old_goal))
+        .await?
+        .ok_or_else(|| anyhow::anyhow!("old goal should clear"))?;
+    let replacement = harness
+        .goal_service
+        .create_thread_goal_exact(
